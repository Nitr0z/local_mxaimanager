{{!
    Credit wallet bar — displayed when quota_display_mode = 'credits'
    Read-only display for clients. Recharge is done via admin settings page.
}}
{{#has_credits}}
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">
            <i class="fa fa-coins mr-2"></i>
            {{#str}}credit_usage_title, local_mxaimanager{{/str}}
        </h5>
        {{#credit_empty}}
        <div class="alert alert-info mb-2">
            <i class="fa fa-info-circle mr-1"></i>
            {{#str}}credit_empty_info, local_mxaimanager{{/str}}
        </div>
        {{/credit_empty}}
        {{^credit_empty}}
        <div class="d-flex justify-content-between mb-1">
            <span class="font-weight-bold">
                {{credit_balance}} {{#str}}credits_remaining, local_mxaimanager{{/str}}
            </span>
            <small class="text-muted">{{credit_used}} / {{credit_total}}</small>
        </div>
        <div class="progress mb-2" style="height: 12px;">
            <div class="progress-bar {{credit_bar_class}}"
                 role="progressbar"
                 style="width: {{credit_percent}}%"
                 aria-valuenow="{{credit_percent}}"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>
        </div>
        {{#has_expiry}}
        <small class="text-muted">
            {{#credit_expired}}
                <i class="fa fa-exclamation-triangle text-danger mr-1"></i>
                {{#str}}credit_expired, local_mxaimanager{{/str}}
            {{/credit_expired}}
            {{^credit_expired}}
                <i class="fa fa-calendar mr-1"></i>
                {{#str}}credit_expires_on, local_mxaimanager{{/str}} {{credit_expiry}}
            {{/credit_expired}}
        </small>
        {{/has_expiry}}
        {{/credit_empty}}
    </div>
</div>
{{/has_credits}}

{{!
    Token quota bars — displayed when quota_display_mode = 'tokens'
}}
{{#quota_unlimited}}
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">{{#str}}quota_usage_title, local_mxaimanager{{/str}}</h5>
        <div class="d-flex align-items-center">
            <i class="fa fa-infinity mr-2 text-success"></i>
            <span class="text-success font-weight-bold">{{#str}}quota_unlimited, local_mxaimanager{{/str}}</span>
        </div>
    </div>
</div>
{{/quota_unlimited}}
{{#has_quotas}}
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">{{#str}}quota_usage_title, local_mxaimanager{{/str}}</h5>
        {{#bars}}
        <div class="mb-3">
            <div class="d-flex justify-content-between mb-1">
                <small class="font-weight-bold">{{label}}</small>
                <small class="text-muted">{{used}} / {{limit}}</small>
            </div>
            <div class="progress" style="height: 10px;">
                <div class="progress-bar {{bar_class}}"
                     role="progressbar"
                     style="width: {{percent}}%"
                     aria-valuenow="{{percent}}"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>
            </div>
        </div>
        {{/bars}}
    </div>
</div>
{{/has_quotas}}
